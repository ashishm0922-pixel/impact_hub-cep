{
  "name": "hopeconnect-api",
  "version": "0.1.0",
  "private": true,
  "description": "HopeConnect AI backend: Express + TypeScript + MongoDB (Mongoose)",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "tsx src/scripts/dev-local.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "seed": "tsx src/scripts/seed.ts",
    "db:check": "tsx src/scripts/check-db.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
