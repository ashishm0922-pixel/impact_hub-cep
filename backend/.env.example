# Copy this file to ".env" and fill in your own values. NEVER commit .env.

# ── MongoDB Atlas ──────────────────────────────────────────────
# Atlas → your cluster → Connect → Drivers → copy the connection string.
# Replace <username>/<password> and put the database name ("hopeconnect") before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hopeconnect?retryWrites=true&w=majority

# If you get "querySrv ECONNREFUSED", your network's DNS can't find Atlas. Uncomment this:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Admin account (created automatically on first start) ───────
# Username: 3–32 chars, lowercase letters/numbers/._-
# Password: 12+ chars with lowercase, uppercase, number and symbol.
# ALWAYS keep the password in double quotes: without them, a "#" starts a comment
# and everything after it would be silently cut off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD="change-me-to-a-strong-password"

# ── Optional ───────────────────────────────────────────────────
PORT=4000
# false (recommended): users log in right after sign-up and verify their email.
# true: an admin must ALSO approve every new account before it can log in.
REQUIRE_ADMIN_APPROVAL=false
USER_SESSION_DAYS=7
ADMIN_SESSION_HOURS=8
# Failed login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10
# Only needed if the website is opened from a different address than the API
CORS_ORIGIN=http://localhost:5500
# Set to true in production behind a proxy (Render/Railway/Nginx)
TRUST_PROXY=false

# ── Email (verification links) ─────────────────────────────────
# Without these, emails are NOT sent: the verification link is printed in the terminal instead.
# Gmail: turn on 2-Step Verification, then create an "App password" at
#   https://myaccount.google.com/apppasswords  and paste it as SMTP_PASS (16 letters, no spaces).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS="your-16-letter-app-password"
# MAIL_FROM="HopeConnect <yourname@gmail.com>"

# Address of the website, used inside the email links (change when you deploy)
# APP_URL=http://localhost:4000
